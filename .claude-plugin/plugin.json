{
  "name": "rystic",
  "displayName": "Rystic",
  "version": "0.1.1",
  "description": "Run stateful API simulators (Stripe, GitHub, Slack, Shopify and more) from your coding agent: start, seed, move the clock, inspect state and calls, diff state and save runs as test cases.",
  "homepage": "https://www.rystic.ai/docs/mcp-server",
  "repository": "https://github.com/Rystic-Inc/rystic",
  "license": "MIT",
  "author": {
    "name": "Rystic",
    "email": "help@rystic.ai",
    "url": "https://www.rystic.ai"
  },
  "keywords": [
    "rystic",
    "rystic simulator",
    "rystic mcp"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/check-rystic.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
